# Backend Environment Variables Template
# Copy this to .env and fill with your values
# NEVER commit .env file to Git!

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE (MongoDB)
# ============================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/traveloop

# MongoDB Atlas (cloud) - Recommended for production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/traveloop?retryWrites=true&w=majority

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# EMAIL CONFIGURATION (Gmail)
# ============================================
# 1. Enable 2FA on Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate App Password and paste it below (without spaces)

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# ============================================
# URLs
# ============================================
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ============================================
# CLOUDINARY (Optional - for image uploads)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# CLOUDINARY (File Uploads)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://yourdomain.com

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# EMAIL (for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_EMAIL=noreply@traveloop.com

# ============================================
# ODOO INTEGRATION
# ============================================
ODOO_URL=https://your-odoo-instance.com
ODOO_API_KEY=your_odoo_api_key
ODOO_DATABASE=your_database_name

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=combined

# ============================================
# REDIS (optional, for caching)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=optional_redis_password

# ============================================
# STRIPE (for payments, optional)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key

# ============================================
# GOOGLE MAPS API (for location services)
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# MISC
# ============================================
API_VERSION=v1
REQUEST_TIMEOUT=30000
MAX_FILE_SIZE=10mb
