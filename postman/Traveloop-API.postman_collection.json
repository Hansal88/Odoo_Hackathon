              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"bio\": \"Travel enthusiast\",\n  \"preferences\": {\n    \"travelStyle\": \"adventure\",\n    \"interests\": [\"hiking\", \"culture\"]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "profile"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Create Trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Summer Europe Trip\",\n  \"description\": \"Exploring Europe\",\n  \"destination\": {\n    \"country\": \"France\",\n    \"city\": \"Paris\",\n    \"latitude\": 48.8566,\n    \"longitude\": 2.3522\n  },\n  \"startDate\": \"2024-06-01\",\n  \"endDate\": \"2024-06-15\",\n  \"budget\": 5000\n}"
            },
            "url": {
              "raw": "{{base_url}}/trips",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "trips"
              ]
            }
          }
        },
        {
          "name": "Get All Trips",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/trips?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "trips"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Trip Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/trips/:tripId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "trips",
                ":tripId"
              ],
              "variable": [
                {
                  "key": "tripId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Update Trip",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Summer Europe Trip 2024\",\n  \"budget\": 6000\n}"
            },
            "url": {
              "raw": "{{base_url}}/trips/:tripId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "trips",
                ":tripId"
              ],
              "variable": [
                {
                  "key": "tripId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Delete Trip",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/trips/:tripId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "trips",
                ":tripId"
              ],
              "variable": [
                {
                  "key": "tripId",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
